---
// font-family
import '@fontsource/zen-kaku-gothic-antique';
// Supports weights 100-900
import '@fontsource-variable/lexend/wght.css';
---


<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>LEAMAN CUT</title>
		<meta name="description" content="LEAMAN CUT の公式webサイトです。" />
	</head>
	<body>
		<div class="container">
			<slot />
		</div>
		<script src="../../js/main.js"></script>
	</body>
</html>

<style is:global>
	:root{
		--Base-color:#FAFAFA;
		--Main-color:#0D0A67;
		--Accent-color:#EA8017;
		--Accent-color2:#0046DE;

		--title-rectangle-color:linear-gradient(to right, #F29D48,#EA8017);

		--PC-Title-font-size:6rem;
		--Font-family-en:'Lexend Variable', sans-serif;
		--Font-family-jp:'Zen Kaku Gothic Antique', sans-serif;
		--font-color-black:#1a1a1a;

		--PC-top-margin:200px;
		--PC-top-padding:100px;
	}
	html,
	body {
		margin: 0;
		padding:0;
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		background-color:var(--Base-color);

		
	}

	img {
	display: block;      /* 謎の隙間を消す */
	max-width: 100%;     /* 親要素からはみ出さないようにする */
	height: auto;        /* 比率を維持して自動調整 */
	}

	h1, h2, h3, p {
	margin: 0;         /* 勝手な余白を消す */
	font-size: inherit; /* 勝手なサイズ変更を無効化 */
	font-weight: inherit; /* 勝手な太字化を無効化 */
}

	.container{
		/* margin: 0 auto;
		max-width: 1440px;
		width: 100%;
		padding:0 8.33%; */
		display:grid;
		grid-template-columns:minmax(7rem, 1fr) minmax(auto, 2000px) minmax(7rem,1fr) ;
		
	}
	
	.container > * {
    	grid-column: 2; /* 明示的に「真ん中の列に入れ！」と命令 */
	}

	.section {
		margin-top:var(--PC-top-margin);
	}

</style>
