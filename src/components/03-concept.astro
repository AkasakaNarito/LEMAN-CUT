---
   import { Image } from 'astro:assets';
   import conceptImg from '../images/concept-img.png';
---




<div class="section">
    <div class="content">
        <div class="content-text">
            <div class="title"><h1 class="title-content">CONCEPT</h1><div class="title-rectangle"></div></div>
            <div class="sub-title"><p class="sub-title-content">素早<br>綺麗に<br>男らしく</p></div>
            <div class="lead-text"><p class="lead-text-content">男らしい髪形にしたい。<br>休憩の合間にサッと散髪したいあなたへ。</p></div>
        </div>
    
        <div class="content-img">
            <Image src={conceptImg} alt="散髪風景" />
        </div>
    </div>
    
</div>

<style>
    .section {
        padding:0 8%;
    }
    
    .content {
        width:100%;
        margin:0 auto;
        justify-content: space-between;
        display:flex;
        
    }

    .content-text {
       display:flex;
       flex-direction:column;
       gap:50px 0;
       
    }

    .title {
        position:relative;
    }

    .title-content {
        font-family:var(--Font-family-en);
        font-size:var(--PC-Title-font-size);
        font-weight:bold;
        color:var(--Main-color);
        
    }

    .title-rectangle {
        width:100%;
        height:40px;
        background:linear-gradient(to right, #F29D48,#EA8017);
        position:absolute;
        bottom:0;
        left:0;
        z-index:-1;
    }

    

    .sub-title-content {
        color:var(--font-color-black);
        font-family:var(--Font-family-jp);
        font-weight:bold;
        font-size:3rem;
        line-height:1.3;
    }

    

    .lead-text-content {
        color:var(--font-color-black);
        font-weight:bold;
        font-size:1.5rem;
    }

    .content-img {
        width:460px;
        height:500px;
        
    }

    .content-img img {
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:65% 0;
        border-radius:5px;
    }
</style>